{
  "name": "@useless-engineer/utils",
  "version": "0.1.0",
  "description": "repo for small, utility functions by useless engineer",
  "author": "Useless Engineer",
  "keywords": [
    "utils",
    "typescript",
    "react-native",
    "debounce",
    "throttle"
  ],
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saurabhbandkar/useless-engineer.git"
  },
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/saurabhbandkar/useless-engineer/issues"
  },
  "homepage": "https://github.com/saurabhbandkar/useless-engineer#readme",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react-native": {
      "import": {
        "types": "./dist/react-native/index.d.ts",
        "default": "./dist/react-native/index.js"
      },
      "require": {
        "types": "./dist/react-native/index.d.cts",
        "default": "./dist/react-native/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "react-native": [
        "./dist/react-native/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.72"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "allowScripts": {
    "esbuild": true
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
